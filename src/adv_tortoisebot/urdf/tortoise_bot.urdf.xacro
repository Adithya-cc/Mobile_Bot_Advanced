<?xml version="1.0"?>
<robot name="tortoisebot" xmlns:xacro = "http://www.ros.org/wiki/xacro">


  <xacro:include filename='robot_core.xacro' />

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_footprint">
  </link>

  <xacro:include filename="lidar_sensor.xacro" />
  <!-- <xacro:include filename="camera_sensor.xacro" />
  <xacro:include filename='depth_cam.xacro' />  -->
  <!-- <xacro:include filename='gazebo_control.xacro' /> -->
  <!-- <xacro:include filename="$(find myrobot_gazebo)/urdf/myrobot.gazebo" /> -->

  <xacro:include filename='ros2_control.xacro' /> 

</robot>
